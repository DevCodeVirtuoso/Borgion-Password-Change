<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <startup>
    <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.8" />
  </startup>
  <appSettings>
    <!-- Tekst onderaan het venster. Pas aan naar je eigen servicedesk. -->
    <add key="HelpdeskText" value="Hulp nodig? Neem contact op met de Borgion servicedesk." />
    <!-- Optioneel: minimale lengte die de app toont als het domeinbeleid niet uitgelezen kan worden. -->
    <add key="FallbackMinLength" value="8" />
  </appSettings>
</configuration>
